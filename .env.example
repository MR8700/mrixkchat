# ==============================================================================
# MRixk — Configuration de Mise en Production (Template Sécurisé)
# Copiez ce fichier vers .env et remplacez les valeurs par des clés secrètes uniques.
# ==============================================================================

# Mode d'exécution (production / development)
APP_ENV=production

# Port d'écoute du serveur principal
PORT=8080

# Emplacement du stockage durable d'état (dossier persistant protégé)
DATA_FILE_PATH=/var/lib/mrixk/data/mrixk_state.json

# Quota maximal d'appareils actifs par compte (standard de souveraineté MRixk)
MAX_DEVICES_PER_USER=3

# Clé de signature secrète (Générez une clé aléatoire forte de 64 caractères)
# Exemple de génération sous Linux : openssl rand -hex 32
JWT_SIGNING_KEY=REMPLACER_PAR_CLE_SECRETE_UNIQUE_ALEATOIRE_64_HEX

# Base de données PostgreSQL (production)
DATABASE_URL=postgres://mrixk_user:MOT_DE_PASSE_TRES_FORT@localhost:5432/mrixk?sslmode=require

# Cache & coordination temps réel Redis
REDIS_URL=redis://:MOT_DE_PASSE_REDIS@localhost:6379/0

# Stockage distribué des pièces jointes chiffrées (S3 / MinIO)
STORAGE_ENDPOINT=https://storage.mondomaine.com
STORAGE_BUCKET=mrixk-media-production
STORAGE_ACCESS_KEY=IDENTIFIANT_ACCES_STORAGE
STORAGE_SECRET_KEY=CLE_SECRETE_STORAGE

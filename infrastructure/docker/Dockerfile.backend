# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git gcc musl-dev

COPY . .

WORKDIR /app/backend
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/mrixk-server ./cmd/server

# Final runtime stage
FROM alpine:3.19

WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app/bin/mrixk-server /app/mrixk-server
COPY --from=builder /app/infrastructure/postgres/migrations /app/migrations

EXPOSE 8080

ENTRYPOINT ["/app/mrixk-server"]
